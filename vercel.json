{
  "installCommand": "npm run setup",
  "buildCommand": "npm run db:check && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/node_modules/pdfkit/js/data/**"
    }
  }
}
