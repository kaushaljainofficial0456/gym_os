node_modules/

# secrets — never commit credentials
.env
backend/.env
.env.*
*.env.local
!.env.example

backend/data/
backend/data/exports/
*.db
# SQLite WAL sidecars -- *.db alone does not match these, so a stray
# database left by a script run from the wrong cwd showed up as untracked.
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

dist/
build/
*.log

# food benchmark: regenerable run outputs (baseline.v1.json + food_eval_set.v1.json ARE committed)
ml/data/benchmark/report.*.json
ml/data/benchmark/report.*.txt

.vscode/
.DS_Store
Thumbs.db
.freebuff/

# Claude Code local-only state -- launch.json (dev server configs) is
# shared/committed; personal permissions and worktree checkouts are not.
.claude/settings.local.json
.claude/worktrees/
.vercel

# Playwright (frontend/playwright.config.js): saved sign-in sessions and run
# output. Screenshot baselines under e2e/__screenshots__ ARE committed.
frontend/e2e/.auth/
frontend/e2e/.results/
frontend/e2e/.report/
