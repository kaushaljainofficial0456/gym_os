<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only. Debug builds add the
     emulator's host alias for local testing (src/debug/res/xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
