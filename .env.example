[TEMPLATE]
# --- Backend ---
PORT=4000

# REQUIRED in production: strong secret, 16+ chars. The app refuses to start
# with NODE_ENV=production unless this is set and strong.
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Database policy: SQLite (dev) vs PostgreSQL/Neon (staging + production).
# DATABASE_URL is REQUIRED for staging/production — the app refuses to start
# without it there. Leave it unset for local development (SQLite, Node 22 built-in).
# IMPORTANT: use the RUNTIME role (e.g. skos_app, NOBYPASSRLS so RLS is enforced),
# NEVER Neon's admin role (neondb_owner has BYPASSRLS, which disables RLS):
#   DATABASE_URL=postgres://skos_app:...@host:5432/dbname?sslmode=verify-full
# After setting it, run:  npm run db:init   (schema + RLS policies; idempotent)
#   and optionally:       npm run db:seed  (demo data ONLY — never on production)
DATABASE_URL=

# Admin/migration role — used ONLY by `npm run pg:validate` (runs schema, migrations
# and RLS as the admin role while the checks run as the runtime role above).
# The running app never connects with this. Never commit real credentials.
PG_ADMIN_URL=

# --- Environment ---
# Set to "production" for the strong-secret gate + safe error messages.
NODE_ENV=development

# --- Org Setup Gate ---
# POST /auth/setup-org is the "Enterprise" option on the login screen --
# public self-serve gym signup, open in every environment by default (like
# any SaaS's own "start free trial"). Set SETUP_SECRET only if you want to
# lock it down to invite-only: once set, the client must send it in the
# X-Setup-Secret header, in every environment, or the request is refused.
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETUP_SECRET=

# --- Google Sign-In (independent clients) ---
# Backs the "Independent client" option on the login screen. ID-token
# verification only (Google Identity Services) -- no client SECRET needed,
# only the Client ID, used as the expected token audience. Get it from
# Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Add both
# http://localhost:5173 and your deployed frontend origin under
# "Authorized JavaScript origins" (no path, no trailing slash). Same value
# goes in both places below -- backend verifies the token audience matches,
# frontend hands it to Google Identity Services to request the token.
# GOOGLE_CLIENT_ID=

# --- Packaged-food barcode lookup ---
# Live fallback for GET /intel/foods/barcode/:code when a scanned barcode
# isn't in the local snapshot (ml/data/processed/off_barcode_index.json) or
# the DB cache (foods.barcode). Defaults to Open Food Facts' public v3 API --
# free, keyless, no signup (v2 is also accepted if you override this, but
# OFF's own docs recommend v3 for new integrations). Only override these if
# you want to point at a different/self-hosted product database.
# FOOD_DATABASE_API_URL=https://world.openfoodfacts.org/api/v3/product
# Only needed if you swap in a provider that requires one -- Open Food Facts does not.
# FOOD_DATABASE_API_KEY=

# --- CORS ---
# Comma-separated allow-list of frontend origins. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Timezone (default for orgs that don't set their own) ---
TIMEZONE=Asia/Kolkata

# --- AI provider ---
# ollama (local dev, default) | openai | gemini | mock
# ZERO-COST SAFETY: Paid providers (openai, gemini) are BLOCKED by default.
# Even if AI_PROVIDER=openai and OPENAI_API_KEY is set, calls will fail
# until you explicitly opt in:  ALLOW_PAID_AI=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# ALLOW_PAID_AI=false   # Set to 'true' ONLY if you accept paid API billing
# LLM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=          # api.groq.com -- has a free tier, but still gated
#                         # by ALLOW_PAID_AI like any other third-party vendor

# --- Food AI (Tier 4 estimation fallback, skos-food-v1) ---
# Backs "Estimate with AI" in FoodLogSheet -- reached only when a food name
# search finds nothing usable. Independent of the AI_PROVIDER above: food
# estimation can reasonably want a different vendor/model than chat
# coaching.
#
# ZERO-CONFIG DEFAULT: leave FOOD_AI_PROVIDER unset and Tier 4 tries, in
# order, only the providers you've actually configured a key for: Groq ->
# Gemini -> OpenRouter -> Ollama (local) -> graceful "unresolved". Each
# step runs ONLY if the previous one genuinely failed (timeout / rate
# limit / 4xx-5xx / malformed response / schema-invalid) -- a success
# never triggers the next provider. With nothing configured at all, only
# Ollama is ever attempted, so it works out of the box, zero-cost, exactly
# like the rest of the app.
#
# FOOD_AI_PROVIDER=groq            # ollama | openai | gemini | groq | openrouter
#                                   # PINS to this ONE provider (+ optional
#                                   # fallback below) instead of the chain above.
# FOOD_AI_FALLBACK_PROVIDER=       # tried once if FOOD_AI_PROVIDER fails (only meaningful when FOOD_AI_PROVIDER is set)
# FOOD_AI_MODEL=                   # provider-specific model id; falls back to that provider's own default
# FOOD_AI_TIMEOUT_MS=15000         # per-attempt request timeout
#
# GROQ_API_KEY=                    # console.groq.com -- gated by ALLOW_PAID_AI like any other vendor
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=                  # aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_API_KEY=              # openrouter.ai/keys
# OPENROUTER_MODEL=                # pick a SPECIFIC model from openrouter.ai/models?max_price=0 --
#                                   # the bare "openrouter/free" alias was found (live-tested) to
#                                   # resolve to an unsuitable safety-classifier model, not a chat
#                                   # model. Free-tier models are also subject to a shared upstream
#                                   # rate limit independent of your own key.
#
# COST SAFETY BEYOND THE ZERO-COST GATE ABOVE: a free-tier account with NO
# payment method attached cannot be billed by hitting its quota -- Groq/
# Gemini just return 429 and the chain already falls through to the next
# provider. That protection lives on the vendor's OWN account settings
# though, invisible to this app. These two are this app's own backstop:
# FOOD_AI_RATE_LIMIT_COOLDOWN_MS=300000  # after a 429, skip that provider (no call at all) for this long instead of re-hitting it every request
# FOOD_AI_DAILY_LIMIT_GROQ=              # hard ceiling on real Groq calls/UTC day, enforced by THIS APP regardless of what the vendor account would allow. Unset = no extra ceiling (default, unchanged behaviour).
# FOOD_AI_DAILY_LIMIT_GEMINI=            # same, for Gemini
# FOOD_AI_DAILY_LIMIT_OPENROUTER=        # same, for OpenRouter
# Once a provider is capped for the day, it's skipped exactly like an
# unconfigured one; if every cloud provider is capped/unavailable, Tier 4
# reports "unresolved" exactly as it always has -- Tier 1-3 (measured
# database, compositional, kNN) are unaffected, entirely local and free.

# --- Storage ---
# local (default: private files under backend/data/uploads, authenticated route)
# s3   (S3-compatible object storage: AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3:
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Frontend (Vite) ---
# VITE_API_TARGET=http://localhost:4000 (used by the dev proxy)
# Same Client ID as GOOGLE_CLIENT_ID above. Safe to expose -- a Google
# OAuth Client ID is a public identifier, not a secret; it's meant to ship
# in frontend code. Set this in frontend/.env for local dev, and as a
# Vercel env var on the frontend project for production (Vite bakes
# VITE_-prefixed vars in at BUILD time, so it must be set before deploying,
# not just at runtime).
# VITE_GOOGLE_CLIENT_ID=
