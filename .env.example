[TEMPLATE]
# --- Backend ---
PORT=4000

# REQUIRED in production: strong secret, 16+ chars. The app refuses to start
# with NODE_ENV=production unless this is set and strong.
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Database policy: SQLite (dev) vs PostgreSQL/Neon (staging + production).
# DATABASE_URL is REQUIRED for staging/production — the app refuses to start
# without it there. Leave it unset for local development (SQLite, Node 22 built-in).
# IMPORTANT: use the RUNTIME role (e.g. skos_app, NOBYPASSRLS so RLS is enforced),
# NEVER Neon's admin role (neondb_owner has BYPASSRLS, which disables RLS):
#   DATABASE_URL=postgres://skos_app:...@host:5432/dbname?sslmode=verify-full
# After setting it, run:  npm run db:init   (schema + RLS policies; idempotent)
#   and optionally:       npm run db:seed  (demo data ONLY — never on production)
DATABASE_URL=

# Admin/migration role — used ONLY by `npm run pg:validate` (runs schema, migrations
# and RLS as the admin role while the checks run as the runtime role above).
# The running app never connects with this. Never commit real credentials.
PG_ADMIN_URL=

# --- Environment ---
# Set to "production" for the strong-secret gate + safe error messages.
NODE_ENV=development

# --- Org Setup Gate ---
# In production/staging, SETUP_SECRET must be set. The client must send
# it in the X-Setup-Secret header to create new organizations.
# In development mode the endpoint is open (no secret required).
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETUP_SECRET=

# --- CORS ---
# Comma-separated allow-list of frontend origins. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Timezone (default for orgs that don't set their own) ---
TIMEZONE=Asia/Kolkata

# --- AI provider ---
# ollama (local dev, default) | openai | gemini | mock
# ZERO-COST SAFETY: Paid providers (openai, gemini) are BLOCKED by default.
# Even if AI_PROVIDER=openai and OPENAI_API_KEY is set, calls will fail
# until you explicitly opt in:  ALLOW_PAID_AI=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# ALLOW_PAID_AI=false   # Set to 'true' ONLY if you accept paid API billing
# LLM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Storage ---
# local (default: private files under backend/data/uploads, authenticated route)
# s3   (S3-compatible object storage: AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3:
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Frontend (Vite) ---
# VITE_API_TARGET=http://localhost:4000 (used by the dev proxy)
